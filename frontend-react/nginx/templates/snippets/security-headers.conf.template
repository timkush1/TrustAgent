# Security headers for everything nginx serves itself (included by the static
# locations in default.conf; a location with its own add_header does not
# inherit server-level ones). connect-src 'self' also covers the same-origin
# WebSocket; DASHBOARD_CONNECT_SRC adds origins for a cross-origin
# DASHBOARD_API_BASE / DASHBOARD_WS_URL.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ${DASHBOARD_CONNECT_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header Referrer-Policy "no-referrer" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
