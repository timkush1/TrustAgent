    {
      "title": "Audit Throughput",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(trustagent_gateway_audit_jobs_total{job=\"proxy\"}[5m]))",
          "legendFormat": "Gateway jobs - {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (status) (rate(trustagent_engine_audits_total{job=\"engine\"}[5m]))",
          "legendFormat": "Engine audits - {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "ops"
        }
      },
      "description": "Deep-audit jobs the gateway queued, by outcome, next to the audits the engine ran, by status. Each series comes from one job, so nothing is counted twice.",
      "id": 2
    },
    {
      "title": "Hallucination Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(trustagent_engine_hallucinations_detected_total{job=\"engine\"}[5m])) / sum(rate(trustagent_engine_audits_total{job=\"engine\",status!=\"error\"}[5m]))",
          "legendFormat": "Hallucination rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      },
      "description": "Share of finished deep audits (success or degraded) with the verdict HALLUCINATED.",
      "id": 3
    },
