# Build context of backend-python/Dockerfile, which is the REPOSITORY ROOT
# (`docker build -f backend-python/Dockerfile .`; compose and CI do the same).
# BuildKit uses this Dockerfile-specific file instead of the root .dockerignore.
#
# Allow-list: everything is excluded, then only what the image installs or
# ships is let back in. Secrets such as .env can never reach the build this way.

*

!proto/evaluator.proto
!contracts/
!backend-python/pyproject.toml
!backend-python/poetry.lock
!backend-python/README.md
!backend-python/src/
!backend-python/data/
!backend-python/scripts/

# Contracts: the JSON/YAML files only; not the npm validator or the Go module.
contracts/node_modules/
# Build tooling (the api.v1 schema generator and its node_modules) is not an image input.
contracts/tools/
contracts/**/*.go
contracts/go.mod
contracts/*.mjs
contracts/package*.json

# Stubs are generated inside the image from proto/; a stale local copy must not
# shadow them.
backend-python/src/truthtable/grpc/pb/*_pb2*.py*

# Python caches and build output.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/

# Editor and OS noise, secrets.
**/.DS_Store
**/.env
**/.env.*
