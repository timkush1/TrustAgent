# Build context for backend-python/Dockerfile (compose/CI build with context
# ./backend-python). The image copies pyproject.toml, src/ (including the
# gitignored generated stubs in src/truthtable/grpc/pb), data/ and scripts/,
# so none of those may be excluded here. poetry.lock and README.md stay in the
# context for a lockfile-based / package install.

# VCS, editor and OS noise
.git
.gitignore
.idea/
.vscode/
**/.DS_Store

# Secrets and local config never enter an image
.env
.env.*

# Virtualenvs and Python caches
.venv/
venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Tests, coverage and eval artifacts (downloaded datasets, reports)
tests/
conftest.py
.coverage
htmlcov/
coverage.xml
evals/datasets/halueval/
eval-*.json
eval-summary.txt
test-results/

# Docs and Docker metadata (README.md is kept: pyproject.toml declares it)
*.md
!README.md
Dockerfile
.dockerignore
