# Build context for backend-go/Dockerfile (compose/CI build with context
# ./backend-go). The image needs go.mod, go.sum and the Go sources, including
# the gitignored generated stubs in api/audit/v1 and the embedded
# internal/store/migrations/*.sql, so none of those may be excluded here.

# VCS, editor and OS noise
.git
.gitignore
.idea/
.vscode/
**/.DS_Store

# Secrets and local config never enter an image
.env
.env.*

# Docs and Docker metadata (not needed to compile)
*.md
Dockerfile
.dockerignore

# Build, test and coverage output
bin/
vendor/
*.exe
*.test
*.out
coverage*
**/*_test.go
**/testdata/
