# TruthTable Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git

# Grafana admin password (REQUIRED - compose refuses to start without it)
GRAFANA_ADMIN_PASSWORD=

# Postgres password for the audit-history database
# (defaults to truthtable-dev for local development; set a real one in prod)
POSTGRES_PASSWORD=

# Upstream LLM URL (defaults to local Ollama)
UPSTREAM_LLM_URL=http://ollama:11434

# ========== Audit-judge LLM provider ==========

# Which model judges the audits: anthropic (default) | openai | ollama.
# The default is Anthropic Claude Haiku for high-quality verification. If no
# ANTHROPIC_API_KEY is set (or the provider is unreachable) the engine
# AUTOMATICALLY falls back to local Ollama — so it works for free out of the box
# and gets dramatically better once you add a key.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5

# Model used for the free local fallback (pull it with `make ollama-pull`).
# The 1B model fits ~2GB RAM; use llama3.2 (3B) if you have >4GB free.
OLLAMA_FALLBACK_MODEL=llama3.2:1b

# Cloud provider keys. Set ANTHROPIC_API_KEY to judge audits with Claude Haiku.
# Never committed; never logged; never sent to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ========== Proxy security ==========

# Comma-separated API keys for /v1/* and /api/* endpoints.
# Empty = authentication DISABLED (local development only!).
# Generate with e.g.:  openssl rand -hex 32
TRUTHTABLE_API_KEYS=

# Comma-separated origins allowed for CORS and WebSocket connections.
TRUTHTABLE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limits (requests per minute per client; client = API key or IP)
# TRUTHTABLE_RATE_LIMIT_PER_MINUTE=120
# TRUTHTABLE_UPLOAD_LIMIT_PER_MINUTE=10

# Request size caps
# TRUTHTABLE_MAX_BODY_BYTES=1048576       # 1 MiB
# TRUTHTABLE_MAX_UPLOAD_BYTES=10485760    # 10 MiB
# TRUTHTABLE_MAX_TEXT_CHARS=20000
