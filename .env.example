# TrustAgent settings (.env). NEVER commit .env.
#
# `make up` and `make demo` create .env from this file when it is missing
# (scripts/configure.py --ensure) and add the generated values the stack needs:
# POSTGRES_PASSWORD, GRAFANA_ADMIN_PASSWORD, TRAFFICGEN_API_KEY and its
# TRUTHTABLE_API_KEYS entry. The demo (`make demo`) needs no keys at all.
#
# These are the common settings, commented out at their defaults: uncomment a
# line to change it. Every other key (all of them advanced) is listed with its
# default in contracts/config/keys.v1.json and can be added here the same way.
# Precedence: built-in default < .env < process environment.

# ---------- Core ----------

# Public dashboard URL: base of the OpenRouter PKCE callback, the cookie Secure
# default and the CSRF origin.
# TRUTHTABLE_PUBLIC_URL=http://localhost:3000

# Host address every published compose port binds to.
# BIND_ADDR=127.0.0.1

# ---------- Auth ----------

# Env API keys as label=key,...; scopes ingest + read + content. Secret.
# TRUTHTABLE_API_KEYS=

# Env API keys with every scope. Admin keys never change the ingest/read auth
# mode. Secret.
# TRUTHTABLE_ADMIN_KEYS=

# ---------- Upstream ----------

# Default upstream for OpenAI-format requests. Empty = https://api.openai.com.
# TRUTHTABLE_UPSTREAM_URL=

# Upstream credential. Setting it enables inject mode: client credentials are
# stripped and this one is sent on TRUTHTABLE_UPSTREAM_AUTH_HEADER. Secret.
# TRUTHTABLE_UPSTREAM_API_KEY=

# ---------- Policy and gate ----------

# Seeds defaults.mode when the policy file omits it. One of: observe, flag,
# block, fallback.
# TRUTHTABLE_GATE_DEFAULT_MODE=observe

# ---------- Decision model ----------

# Fast-check backend. auto: demo -> mock; base URL + TRUTHTABLE_JEV_API_KEY ->
# compatible; OpenRouter key -> openrouter-decisions; TypeSafe key -> typesafe;
# otherwise off. One of: auto, openrouter-decisions, openrouter-systemone,
# typesafe, compatible, mock, off.
# TRUTHTABLE_JEV_BACKEND=auto

# One OpenRouter key powers the fast check and the judge. Secret.
# OPENROUTER_API_KEY=

# Decision model id. ~typesafe/jev-latest and jev-latest are allowed with a
# warning (thresholds are tuned per version). Default: openrouter-*:
# typesafe/jev-1.13; typesafe: jev-1.13.0; compatible: required; mock:
# mock/jev-heuristic-v1.
# TRUTHTABLE_JEV_MODEL=

# ---------- Budgets, Studio ----------

# Daily fast-check spend cap in USD; seeds the runtime budget. 0 = unlimited.
# Past the cap, observe/flag routes skip (degraded: budget), fail-open routes
# pass and fail-closed block routes block.
# TRUTHTABLE_SPEND_CAP_DECISION_USD_DAY=2.00

# Daily deep-audit (LLM judge) spend cap in USD; seeds the runtime budget. 0 =
# unlimited. The cap is hard in every lane.
# TRUTHTABLE_SPEND_CAP_LLM_USD_DAY=5.00

# ---------- Engine: judge ----------

# Deep-audit judge. auto: explicit > Anthropic key > OpenRouter key > OpenAI key
# > Ollama (if reachable) > none; mock in demo mode. One of: auto, anthropic,
# openrouter, openai, ollama, mock, none.
# LLM_PROVIDER=auto

# Anthropic key for the judge. Secret.
# ANTHROPIC_API_KEY=

# ---------- Compose, host, dashboard, build ----------

# Optional compose add-ons. Comma-separated, from: knowledge, local-llm,
# observability, redis, demo, load.
# COMPOSE_PROFILES=
