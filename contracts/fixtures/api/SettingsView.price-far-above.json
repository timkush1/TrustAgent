    "judge": {
      "provider": "openrouter",
      "model": "anthropic/claude-haiku-4.5"
    },
    "upstream": {
      "default": {
        "url": "https://api.openai.com/v1",
        "credential": null,
        "auth_header": "authorization"
      },
      "anthropic": {
        "url": null,
        "credential": null,
        "auth_header": "x-api-key"
      },
      "fallback": {
        "url": null,
        "credential": null,
        "auth_header": "authorization",
        "format": "openai"
      }
    },
    "bindings": {
      "decision_model": "openrouter",
      "judge": "openrouter",
      "upstream_default": null
    },
    "budgets": {
      "decision_usd_day": 2.0,
      "llm_usd_day": 5.0
    },
    "pricing_overrides": [
      {
        "match": "claude-haiku-4-5*",
        "provider": "anthropic",
        "input_per_mtok": 150,
        "output_per_mtok": 5,
        "label": "override"
      }
    ]
  },
  "env_managed": [],
  "warnings": [
    {
      "key": "pricing_overrides",
      "message": "$150 per million tokens is 150× the built-in price of $1; check the units (USD per million tokens).",
      "hint": "Check the price against the provider's price page.",
      "code": "price_far_above_contracts",
      "path": "pricing_overrides[0].input_per_mtok",
      "details": {
        "ratio": 150,
        "contracts_per_mtok": 1,
        "index": 0
      }
    }
  ],
  "dotenv_path": "/app/.env"
}
