{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timkush1/TrustAgent/contracts/schema/benchmark-run.v1.schema.json",
  "title": "BenchmarkRun",
  "description": "docs/benchmarks/results/<run_id>.json (SPEC §2.13), indexed by docs/benchmarks/index.json. Only measured, non-mock runs are ever written (make bench-publish refuses mock).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "created_at",
    "git_sha",
    "tier",
    "measured",
    "mock",
    "dataset",
    "systems",
    "errors",
    "environment"
  ],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "created_at": {"$ref": "common.v1.schema.json#/$defs/ISODateTime"},
    "git_sha": {"$ref": "common.v1.schema.json#/$defs/GitSha"},
    "tier": {"enum": ["lite", "full"]},
    "measured": {"const": true},
    "mock": {"const": false},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subset", "split", "n", "revision", "license_note"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "subset": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "split": {"type": "string", "minLength": 1},
        "n": {"type": "integer", "minimum": 1},
        "revision": {"type": "string", "minLength": 1},
        "license_note": {"type": "string", "minLength": 1}
      }
    },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision_model", "judge", "metrics", "latency_ms", "cost", "reliability"],
        "properties": {
          "id": {"enum": ["gate", "llm_same_checks", "llm_full_audit", "cascade_response"]},
          "decision_model": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["backend", "snapshot"],
                "properties": {
                  "backend": {"$ref": "common.v1.schema.json#/$defs/DecisionBackend"},
                  "snapshot": {"anyOf": [{"type": "string"}, {"type": "null"}]}
                }
              },
              {"type": "null"}
            ]
          },
          "judge": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["provider", "model"],
                "properties": {
                  "provider": {"type": "string", "minLength": 1},
                  "model": {"type": "string", "minLength": 1}
                }
              },
              {"type": "null"}
            ]
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "precision",
              "recall",
              "f1",
              "accuracy",
              "balanced_accuracy",
              "auroc",
              "ece",
              "brier"
            ],
            "properties": {
              "precision": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "recall": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "f1": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "accuracy": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "balanced_accuracy": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "auroc": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "ece": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "brier": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "ci95": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "precision": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  "recall": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  "f1": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  "accuracy": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  "balanced_accuracy": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                  },
                  "auroc": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  "ece": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                  "brier": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}
                },
                "description": "95% confidence intervals [lo, hi] per metric."
              }
            }
          },
          "latency_ms": {
            "type": "object",
            "additionalProperties": false,
            "required": ["p50", "p95"],
            "properties": {
              "p50": {"anyOf": [{"type": "number"}, {"type": "null"}]},
              "p95": {"anyOf": [{"type": "number"}, {"type": "null"}]}
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["usd_total", "usd_per_1k", "cost_source"],
            "properties": {
              "usd_total": {"$ref": "common.v1.schema.json#/$defs/Usd"},
              "usd_per_1k": {"$ref": "common.v1.schema.json#/$defs/Usd"},
              "cost_source": {
                "enum": ["reported", "computed", "free_local", "unknown"],
                "description": "simulated is impossible here (mock is false)."
              },
              "input_tokens_per_answer": {
                "anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}],
                "description": "The mean input tokens of the examples that made a call, as the vendor counted them; null when fewer than 95% of them have a count (D229). A cost per answer grows with the documents' length, so it is published beside the cost."
              }
            }
          },
          "reliability": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lo", "hi", "n", "mean_pred", "frac_pos"],
              "properties": {
                "lo": {"$ref": "common.v1.schema.json#/$defs/Probability"},
                "hi": {"$ref": "common.v1.schema.json#/$defs/Probability"},
                "n": {"type": "integer", "minimum": 0},
                "mean_pred": {"$ref": "common.v1.schema.json#/$defs/Probability"},
                "frac_pos": {"$ref": "common.v1.schema.json#/$defs/Probability"}
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed", "excluded_over_budget"],
      "properties": {
        "failed": {"type": "integer", "minimum": 0},
        "excluded_over_budget": {"type": "integer", "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "concurrency"],
      "properties": {
        "region": {"type": "string", "minLength": 1},
        "concurrency": {"type": "integer", "minimum": 1}
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_host", "judge_host"],
      "description": "The hosts the run actually called (D203), resolved from TRUTHTABLE_OPENROUTER_BASE_URL or TRUTHTABLE_JEV_BASE_URL and the judge provider. A published run names vendor hosts only; null when the run has no such system.",
      "properties": {
        "decision_host": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/VendorHost"}, {"type": "null"}]},
        "judge_host": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/VendorHost"}, {"type": "null"}]}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_revision", "policy_source", "gate_eval_sha256", "host_env"],
      "description": "What the run was made from (D204, D205): the dataset commit, the policy gate-eval ran with (builtin: TRUTHTABLE_POLICY_FILE removed), the gate-eval binary, and the machine's conditions.",
      "properties": {
        "dataset_revision": {"type": "string", "minLength": 1},
        "policy_source": {"enum": ["builtin", "file"]},
        "gate_eval_sha256": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/Sha256Hex"}, {"type": "null"}]},
        "host_env": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mem_available_mb", "loadavg", "platform", "region"],
          "properties": {
            "mem_available_mb": {"type": "integer", "minimum": 0},
            "loadavg": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
            "platform": {"type": "string", "minLength": 1, "maxLength": 64},
            "region": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "scored", "failed", "excluded", "failure_rate"],
      "description": "Examples attempted, scored, failed and excluded over every system (D204). Publish refuses failure_rate > 0.05 or scored < 0.95 * n; by_system has the same counts per system.",
      "properties": {
        "n": {"type": "integer", "minimum": 0},
        "scored": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "failure_rate": {"type": "number", "minimum": 0, "maximum": 0.05},
        "by_system": {
          "type": "object",
          "propertyNames": {"enum": ["gate", "llm_same_checks", "llm_full_audit", "cascade_response"]},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["n", "scored", "failed", "excluded"],
            "properties": {
              "n": {"type": "integer", "minimum": 0},
              "scored": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "excluded": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "dirty": {
      "const": false,
      "description": "Taken at run start (git status --porcelain --untracked-files=no); publish refuses a run started on a dirty tree (D204)."
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection", "gate_concurrency"],
      "description": "How the gate latency was taken (D205): warm (gate-eval --warm made the free key call on the same client first) or cold, and how many gate calls ran at once.",
      "properties": {
        "connection": {"enum": ["warm", "cold"]},
        "gate_concurrency": {"type": "integer", "minimum": 1}
      }
    }
  }
}
