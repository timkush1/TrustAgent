{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timkush1/TrustAgent/contracts/schema/measured.v1.schema.json",
  "title": "MeasuredValues",
  "description": "contracts/claims/measured.json: values derived from docs/benchmarks/results/*.json (accuracy and cost runs) and docs/benchmarks/load/*.json (load-run.v1, D118: the proxy overhead of scenario c folds in with system proxy and its run_id). Written only by make bench-publish, which refuses mock runs and runs on a non-vendor host (D203, D204); until then every value is an explicit null and the UI shows \"not yet measured\".",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "tier", "mock", "generated_by", "generated_at", "runs", "values"],
  "$defs": {
    "vendor_host": {"$ref": "common.v1.schema.json#/$defs/VendorHost"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "snapshot": {"type": "string", "minLength": 1, "maxLength": 128}
  },
  "properties": {
    "schema": {"const": "trustagent.measured/v1"},
    "status": {"enum": ["not_measured", "measured"]},
    "tier": {"anyOf": [{"enum": ["lite", "full"]}, {"type": "null"}]},
    "mock": {"const": false},
    "generated_by": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "generated_at": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/ISODateTime"}, {"type": "null"}]},
    "runs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/run_id"}
    },
    "snapshot": {
      "description": "The decision-model snapshot every measured value comes from (D207). Two snapshots only when sources.snapshot_split is true, and then every surface names both.",
      "anyOf": [
        {"$ref": "#/$defs/snapshot"},
        {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/snapshot"}},
        {"type": "null"}
      ]
    },
    "values": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "unit", "description", "run_id", "system"],
        "properties": {
          "value": {"anyOf": [{"type": "number"}, {"type": "null"}]},
          "unit": {"enum": ["usd_per_1k", "ms", "fraction", "multiplier"]},
          "description": {"type": "string", "minLength": 1},
          "run_id": {"anyOf": [{"$ref": "#/$defs/run_id"}, {"type": "null"}]},
          "system": {
            "anyOf": [
              {"enum": ["gate", "llm_same_checks", "llm_full_audit", "cascade_response", "proxy"]},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "intervals": {
      "type": "object",
      "description": "95% intervals of measured fractions, keyed like values (D212): Wilson for accuracy, a seeded bootstrap for balanced accuracy. n_pos and n_neg are the counts per class shown beside the figure.",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,63}$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lo", "hi", "method"],
        "properties": {
          "lo": {"type": "number"},
          "hi": {"type": "number"},
          "method": {"enum": ["wilson", "bootstrap"]},
          "resamples": {"type": "integer", "minimum": 1},
          "seed": {"type": "integer"},
          "n_pos": {"type": "integer", "minimum": 0},
          "n_neg": {"type": "integer", "minimum": 0}
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the measured values come from (D204, D206, D207). Each <key>_usd_per_1k value names its cost source: reported (usage.cost from the vendor) or computed (measured tokens × vendor price); unknown is refused.",
      "properties": {
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bench_runs", "refused_run_ids"],
          "description": "Every bench-lite run since the measurement began, and the ones publish refused: disclosed, never fished (D204).",
          "properties": {
            "bench_runs": {"type": "integer", "minimum": 0},
            "refused_run_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/run_id"}}
          }
        },
        "snapshot_split": {
          "type": "boolean",
          "description": "true when calibration, bench and recording span two decision-model snapshots (D207 option b); snapshot then lists both."
        },
        "groundedness_ece": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "calibration_file", "calibration_sha256", "dataset"],
          "description": "ECE before and after calibration, measured on the bench's held-out test sample with a calibration fitted on the train split (D206).",
          "properties": {
            "method": {"const": "holdout"},
            "calibration_file": {"type": "string", "pattern": "^config/calibration/[A-Za-z0-9._-]+\\.json$"},
            "calibration_sha256": {"$ref": "common.v1.schema.json#/$defs/Sha256Hex"},
            "dataset": {"type": "string", "minLength": 1}
          }
        }
      },
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,50}_usd_per_1k$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cost_source"],
          "properties": {
            "cost_source": {"enum": ["reported", "computed"]}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "measured"}}},
      "then": {
        "properties": {
          "tier": {"enum": ["lite", "full"]},
          "generated_by": {"type": "string", "minLength": 1},
          "generated_at": {"$ref": "common.v1.schema.json#/$defs/ISODateTime"},
          "runs": {"minItems": 1}
        }
      }
    }
  ]
}
