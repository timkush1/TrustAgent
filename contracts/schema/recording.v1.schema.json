{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timkush1/TrustAgent/contracts/schema/recording.v1.schema.json",
  "title": "Recording",
  "description": "trustagent.recording/v1: manifest.json of a replayable recording (SPEC §2.13), produced only by Go export-replay or GET /api/export/replay. traces/<id>.json hold full TraceDetail bodies (api.v1). kind \"recorded\" is allowed only when the decision backend is not mock/off, the judge is not a fallback, and every trace has answer_source != null. roi and traces[] are checked structurally here; their full shapes (RoiSummary, TraceSummary) live in api.v1.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "label",
    "recorded_at",
    "git_sha",
    "trustagent_version",
    "decision_model",
    "judge",
    "calibration_state",
    "answer_sources",
    "totals",
    "roi",
    "traces",
    "events"
  ],
  "properties": {
    "schema": {"const": "trustagent.recording/v1"},
    "kind": {"enum": ["recorded", "mock"]},
    "label": {"type": "string", "minLength": 1, "maxLength": 300},
    "recorded_at": {"$ref": "common.v1.schema.json#/$defs/ISODateTime"},
    "git_sha": {"$ref": "common.v1.schema.json#/$defs/GitSha"},
    "trustagent_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"},
    "decision_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "snapshot"],
      "properties": {
        "backend": {"$ref": "common.v1.schema.json#/$defs/DecisionBackend"},
        "snapshot": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "host": {
          "$ref": "common.v1.schema.json#/$defs/Hostname",
          "description": "The host the fast check called (D203), bare: the sanitizer scrubs hosts inside URLs. A recorded tape names a vendor host."
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "fallback_active"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "fallback_active": {"type": "boolean"},
        "host": {
          "$ref": "common.v1.schema.json#/$defs/Hostname",
          "description": "The host the judge called (D203), bare. A recorded tape names a vendor host."
        }
      }
    },
    "calibration_state": {"$ref": "common.v1.schema.json#/$defs/CalibrationState"},
    "answer_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scripted", "generated"],
      "properties": {
        "scripted": {"type": "integer", "minimum": 0},
        "generated": {"type": "integer", "minimum": 0},
        "generated_host": {
          "anyOf": [{"$ref": "common.v1.schema.json#/$defs/Hostname"}, {"type": "null"}],
          "description": "The upstream host that wrote the generated answers (D203, D208), bare; null when there are none. A recorded tape with generated answers names a vendor host."
        }
      }
    },
    "featured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "rule"],
      "description": "The trace every launch surface shows (/og, the hero, screenshots, the video, the post), picked by rule and never edited (D209): contradicted_with_span is the first flag, fallback or block trace with a CONTRADICTED claim that has a span (refund-contradiction-flag first, then support-bot); best_flagged is the owner's pick when no trace meets that rule; scripted is the simulated tape's fixed choice.",
      "properties": {
        "trace_id": {"$ref": "common.v1.schema.json#/$defs/Uuid"},
        "rule": {"enum": ["contradicted_with_span", "best_flagged", "scripted"]}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "quality"],
      "description": "The calibration the tape was recorded with (D207, D208): the snapshot of config/calibration/<snapshot>.json and its quality; none when recorded with ALLOW_UNCALIBRATED=1 (the UI then says uncalibrated).",
      "properties": {
        "snapshot": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "quality": {"enum": ["measured", "provisional", "none"]}
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traces", "decision_usd", "llm_usd"],
      "properties": {
        "traces": {"type": "integer", "minimum": 0},
        "decision_usd": {"$ref": "common.v1.schema.json#/$defs/Usd"},
        "llm_usd": {"$ref": "common.v1.schema.json#/$defs/Usd"}
      }
    },
    "roi": {
      "type": "object",
      "required": ["window", "gated_responses", "simulated"],
      "properties": {
        "window": {"enum": ["15m", "1h", "24h", "7d", "30d"]},
        "gated_responses": {"type": "integer", "minimum": 0},
        "simulated": {"type": "boolean"}
      },
      "description": "RoiSummary (api.v1)."
    },
    "traces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trace_id", "created_at", "answer_source"],
        "properties": {
          "trace_id": {"$ref": "common.v1.schema.json#/$defs/Uuid"},
          "created_at": {"$ref": "common.v1.schema.json#/$defs/ISODateTime"},
          "answer_source": {
            "anyOf": [{"$ref": "common.v1.schema.json#/$defs/AnswerSource"}, {"type": "null"}]
          }
        },
        "description": "TraceSummary (api.v1)."
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t_ms", "type", "data"],
        "properties": {
          "t_ms": {"$ref": "common.v1.schema.json#/$defs/Ms"},
          "type": {"$ref": "common.v1.schema.json#/$defs/WsEventType"},
          "trace_id": {"$ref": "common.v1.schema.json#/$defs/Uuid"},
          "data": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "recorded"}}},
      "then": {
        "properties": {
          "decision_model": {
            "required": ["host"],
            "properties": {
              "backend": {"not": {"enum": ["mock", "off"]}},
              "host": {"$ref": "common.v1.schema.json#/$defs/VendorHost"}
            }
          },
          "judge": {
            "required": ["host"],
            "properties": {
              "fallback_active": {"const": false},
              "host": {"$ref": "common.v1.schema.json#/$defs/VendorHost"}
            }
          },
          "answer_sources": {
            "properties": {
              "generated_host": {"anyOf": [{"$ref": "common.v1.schema.json#/$defs/VendorHost"}, {"type": "null"}]}
            },
            "if": {"required": ["generated"], "properties": {"generated": {"minimum": 1}}},
            "then": {
              "required": ["generated_host"],
              "properties": {"generated_host": {"$ref": "common.v1.schema.json#/$defs/VendorHost"}}
            }
          },
          "featured": {"properties": {"rule": {"enum": ["contradicted_with_span", "best_flagged"]}}},
          "traces": {
            "items": {"properties": {"answer_source": {"$ref": "common.v1.schema.json#/$defs/AnswerSource"}}}
          },
          "label": {"pattern": "^Recorded .+ · replayed, not live$"}
        }
      }
    },
    {
      "if": {"properties": {"kind": {"const": "mock"}}},
      "then": {"properties": {"label": {"const": "Simulated (mock checks + mock judge): not model output"}}}
    }
  ]
}
